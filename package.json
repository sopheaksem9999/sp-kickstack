{
  "name": "sp-kickstack",
  "version": "0.2.0",
  "private": true,
  "description": "Cross-repo agent orchestration bridge",
  "engines": {
    "node": "22.19.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run --workspace=@sp-kickstack/shared build && npm run --workspaces --if-present build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run --workspaces --if-present typecheck",
    "demo": "npx tsx scripts/demo-flow.ts",
    "mcp": "npx tsx packages/server/src/mcp/run.ts",
    "dev": "node scripts/dev.mjs",
    "dev:server": "npm run --workspace=@sp-kickstack/server dev",
    "dev:web": "npm run --workspace=@sp-kickstack/web dev",
    "desktop:dev": "npm run --workspace=@sp-kickstack/desktop dev",
    "desktop:build": "npm run --workspace=@sp-kickstack/desktop build:desktop"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
