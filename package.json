{
  "name": "sp-kickstack",
  "version": "0.3.6",
  "private": true,
  "description": "Cross-repo agent orchestration bridge",
  "engines": {
    "node": "22.19.0"
  },
  "packageManager": "pnpm@9.15.4",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm --filter @sp-kickstack/shared build && pnpm --filter @sp-kickstack/server build && pnpm --filter @sp-kickstack/web build && pnpm --filter @sp-kickstack/xticket build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --if-present run typecheck",
    "verify": "pnpm run typecheck && vitest run",
    "demo": "npx tsx scripts/demo-flow.ts",
    "mcp": "npx tsx packages/server/src/mcp/run.ts",
    "dev": "node scripts/dev.mjs",
    "dev:server": "pnpm --filter @sp-kickstack/server dev",
    "dev:web": "pnpm --filter @sp-kickstack/web dev",
    "desktop:dev": "pnpm --filter @sp-kickstack/desktop dev",
    "desktop:bundle-server": "node scripts/bundle-desktop-server.mjs",
    "desktop:build": "node scripts/bundle-desktop-server.mjs && pnpm --filter @sp-kickstack/web build && pnpm --filter @sp-kickstack/desktop build:desktop",
    "version:bump": "node scripts/bump-version.mjs",
    "bump": "node scripts/bump-version.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
