{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SP Kickstack",
  "version": "0.2.2",
  "identifier": "com.spkickstack.desktop",
  "build": {
    "beforeDevCommand": "pnpm --prefix ../.. dev",
    "devUrl": "http://localhost:4101",
    "beforeBuildCommand": "node ../../scripts/bundle-desktop-server.mjs && pnpm --filter @sp-kickstack/web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "SP Kickstack — AI Studio Bridge",
        "width": 1280,
        "height": 850,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/Square30x30Logo.png",
      "icons/Square44x44Logo.png",
      "icons/Square71x71Logo.png",
      "icons/Square89x89Logo.png",
      "icons/Square107x107Logo.png",
      "icons/Square142x142Logo.png",
      "icons/Square150x150Logo.png",
      "icons/Square310x310Logo.png"
    ],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15"
    }
  }
}
